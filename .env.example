# MapLibre-compatible style URL. Defaults to OpenFreeMap for development if empty.
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Managed Valhalla URL ending in /route (public demo is used if empty)
EXPO_PUBLIC_VALHALLA_URL=
# Optional future custom-route proxy
EXPO_PUBLIC_ROUTE_PROXY_URL=
